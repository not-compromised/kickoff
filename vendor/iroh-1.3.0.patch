+#[pin_project::pinned_drop]
+impl PinnedDrop for Sender {
+    fn drop(self: Pin<&mut Self>) {
+        for bind in self.sock.ip_bind_addrs() {
+            kickoff_send_guard::forget(*bind, self.sender.context);
+        }
+    }
