+                Poll::Ready(Some(ConnectionEvent::Rebind(mut sender))) => {
+                    self.sender.as_mut().set_connection_context(0, self.send_initial_destination, self.send_is_client);
+                    sender.as_mut().set_connection_context(self.send_context, self.send_initial_destination, self.send_is_client);
